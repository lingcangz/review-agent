  "components": {
    "schemas": {
      "AuthTokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": ["access_token", "expires_at"],
        "title": "AuthTokenResponse"
      },
      "ContextUploadRequest": {
        "properties": {
          "context": {
            "items": {
              "$ref": "#/components/schemas/RequestedContext"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Context"
          }
        },
        "type": "object",
        "required": ["context"],
        "title": "ContextUploadRequest"
      },
      "EmailLoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "organization_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Organization Id"
          }
        },
        "type": "object",
        "required": ["email", "organization_id"],
        "title": "EmailLoginRequest"
      },
      "EmailLoginResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": ["message"],
        "title": "EmailLoginResponse"
      },
      "EmailLoginVerify": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "token": {
            "type": "string",
            "maxLength": 200,
            "minLength": 20,
            "title": "Token"
          },
          "organization_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Organization Id"
          }
        },
        "type": "object",
        "required": ["email", "token", "organization_id"],
        "title": "EmailLoginVerify"
      },
      "Finding": {
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["P0", "P1", "P2"],
            "title": "Severity"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "start_line": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Start Line"
          },
          "end_line": {
            "type": "integer",
            "minimum": 1.0,
            "title": "End Line"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "evidence": {
            "type": "string",
            "title": "Evidence"
          },
          "recommendation": {
            "type": "string",
            "title": "Recommendation"
          }
        },
        "type": "object",
        "required": [
          "severity",
          "path",
          "start_line",
          "end_line",
          "title",
          "evidence",
          "recommendation"
        ],
        "title": "Finding"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InvitationAccept": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 200,
            "minLength": 20,
            "title": "Code"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          }
        },
        "type": "object",
        "required": ["code", "email"],
        "title": "InvitationAccept"
      },
      "InvitationCreate": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "enum": ["admin", "member"],
            "title": "Role",
            "default": "member"
          }
        },
        "type": "object",
        "required": ["email"],
        "title": "InvitationCreate"
      },
      "InvitationResponse": {
        "properties": {
          "invitation_id": {
            "type": "string",
            "title": "Invitation Id"
          },
          "code": {
            "type": "string",
            "title": "Code",
            "description": "仅在创建时返回；应通过安全渠道传递。"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": ["invitation_id", "code", "expires_at"],
        "title": "InvitationResponse"
      },
      "OrganizationCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "owner_email": {
            "type": "string",
            "format": "email",
            "title": "Owner Email"
          }
        },
        "type": "object",
        "required": ["name", "owner_email"],
        "title": "OrganizationCreate"
      },
      "OrganizationResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": ["id", "name"],
        "title": "OrganizationResponse"
      },
      "PersonalAccessTokenCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "expires_in_days": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 365.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires In Days",
            "default": 90
          }
        },
        "type": "object",
        "required": ["name"],
        "title": "PersonalAccessTokenCreate"
      },
      "PersonalAccessTokenResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "token": {
            "type": "string",
            "title": "Token",
            "description": "仅在创建时返回，请立即保存。"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": ["id", "name", "token", "expires_at"],
        "title": "PersonalAccessTokenResponse"
      },
      "RequestedContext": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path",
            "description": "仓库相对路径"
          },
          "content": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "title": "Content",
            "description": "已脱敏的文件内容"
          }
        },
        "type": "object",
        "required": ["path", "content"],
        "title": "RequestedContext"
      },
      "ReviewRequest": {
        "properties": {
          "diff": {
            "type": "string",
            "maxLength": 500000,
            "minLength": 1,
            "title": "Diff"
          },
          "context": {
            "items": {
              "$ref": "#/components/schemas/RequestedContext"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Context"
          }
        },
        "type": "object",
        "required": ["diff"],
        "title": "ReviewRequest",
        "description": "Diff and explicitly supplied, path-scoped context only."
      },
      "ReviewResponse": {
        "properties": {
          "review_id": {
            "type": "string",
            "title": "Review Id"
          },
          "status": {
            "type": "string",
            "enum": ["queued", "running", "completed", "needs_context", "failed"],
            "title": "Status"
          },
          "report": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Report"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "title": "Findings"
          },
          "requested_context_paths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Requested Context Paths"
          }
        },
        "type": "object",
        "required": ["review_id", "status"],
        "title": "ReviewResponse"
      },
      "RuleCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "instruction": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Instruction"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true
          },
          "priority": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Priority",
            "default": 100
          }
        },
        "type": "object",
        "required": ["name", "instruction"],
        "title": "RuleCreate"
      },
      "RuleResponse": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "instruction": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Instruction"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true
          },
          "priority": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Priority",
            "default": 100
          },
          "id": {
            "type": "string",
            "title": "Id"
          }
        },
        "type": "object",
        "required": ["name", "instruction", "id"],
        "title": "RuleResponse"
      },
      "RuleUpdate": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "instruction": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 10000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Instruction"
          },
          "enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enabled"
          },
          "priority": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Priority"
